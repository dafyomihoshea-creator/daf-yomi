{
  "hosting": {
    "site": "daf-yomi-hoshea",
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/api/rss-feed",
        "destination": "/rss.xml",
        "type": 301
      },
      {
        "source": "/app",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/lesson/**",
        "destination": "/app.html"
      },
      {
        "source": "/masechet/**",
        "destination": "/app.html"
      },
      {
        "source": "/my-lessons",
        "destination": "/app.html"
      },
      {
        "source": "/stats",
        "destination": "/app.html"
      },
      {
        "source": "/playlists",
        "destination": "/app.html"
      },
      {
        "source": "/messages",
        "destination": "/app.html"
      },
      {
        "source": "/login",
        "destination": "/app.html"
      },
      {
        "source": "/admin",
        "destination": "/app.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/!(*.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
